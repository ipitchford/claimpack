  "statement": {
    "definitions": [
      {
        "meaning": "Divisible by the square of at least one prime.",
        "term": "nonsquarefree"
      },
      {
        "meaning": "The largest cardinality of A subset {1,...,N} for which ab+1 is nonsquarefree for every ordered choice a,b in A, including a=b.",
        "term": "f(N)"
      }
    ],
    "language": "en",
    "latex": "f(N)=\\left\\lfloor\\frac{N+18}{25}\\right\\rfloor\\quad\\text{for every }N\\ge1",
    "natural": "For every positive integer N, the maximum size f(N) of a subset A of {1,...,N} such that ab+1 is nonsquarefree for every a,b in A, including a=b, equals floor((N+18)/25).",
    "quantifiers": [
      "for every positive integer N",
      "for every a,b in A including a=b"
    ]
