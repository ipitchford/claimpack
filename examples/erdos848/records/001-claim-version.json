  "statement": {
    "definitions": [
      {
        "meaning": "A subset A of {1,...,N} such that ab+1 is nonsquarefree for every a,b in A, including a=b.",
        "term": "admissible"
      },
      {
        "meaning": "The maximum cardinality of an admissible subset.",
        "term": "f(N)"
      }
    ],
    "language": "en",
    "latex": "N\\ge264000000000000000\\Longrightarrow f(N)\\le\\left\\lfloor\\frac{N+18}{25}\\right\\rfloor",
    "natural": "For every integer N at least 264000000000000000, the maximum size f(N) of an admissible subset is at most floor((N+18)/25).",
    "quantifiers": [
      "for every integer N >= 264000000000000000"
    ]
  }
