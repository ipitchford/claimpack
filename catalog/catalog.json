      "author_claimed_status": "source-reported status; inspect assessment overlays",
      "canonical_status": "unassessed",
      "claim_id": "ni:///sha-256;7wV20SW1VjqzO2MJwLRjy93gidN10nje-Jl3lHLuspA",
